{
  "var": {
    "title": "DER Management",
    "desc": "OES",
    "options": [
      {
        "type": "regions",
        "multiple": false
      }
    ],
    "get": {
      "endpoint": "/config/der.json",
      "protocol": "http"
    },
    "save": [
      {
        "endpoint": "opendso.{{regionID}}.dermgmt.settings.set",
        "protocol": "nats",
        "type": "publish",
        "payload": [
          {
            "label": "enabled",
            "value": "enabledDer"
          },
          {
            "label": "vars",
            "value": "varValue"
          },
          {
            "label": "batteryCharge",
            "value": "batteryCharge"
          },
          {
            "label": "batteryLowNeutral",
            "value": "batteryLowNeutral"
          },
          {
            "label": "batteryHighNeutral",
            "value": "batteryHighNeutral"
          },
          {
            "label": "batteryDischarge",
            "value": "batteryDischarge"
          }
        ]
      }
    ],
    "onLoad": [
      {
        "endpoint": "opendso.{{regionID}}.dermgmt.settings",
        "protocol": "nats",
        "type": "listen",
        "payload": [
          {
            "label": "enabled",
            "value": "enabledDer"
          },
          {
            "label": "vars",
            "value": "varValue"
          },
          {
            "label": "batteryCharge",
            "value": "batteryCharge"
          },
          {
            "label": "batteryLowNeutral",
            "value": "batteryLowNeutral"
          },
          {
            "label": "batteryHighNeutral",
            "value": "batteryHighNeutral"
          },
          {
            "label": "batteryDischarge",
            "value": "batteryDischarge"
          }
        ]
      },
      {
        "endpoint": "opendso.{{regionID}}.dermgmt.settings.get",
        "protocol": "nats",
        "type": "publish"
      }
    ]
  },
